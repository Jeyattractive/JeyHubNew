    if not root then return end
    local bf = Instance.new("BodyForce")
    bf.Force  = Vector3.new(0, forceY, 0)
    bf.Parent = root
    wLite_force = bf
end
local function wLite_fire(target, density)
    local rem = wLite_getRemote()
    if rem then rem:FireServer(target, density) end
end
local function wLite_isSitting()
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    return hum:GetState() == Enum.HumanoidStateType.Seated
end
local function wLite_scanPax()
    local char = LocalPlayer.Character
    if not char then return nil end
    for _, part in ipairs(workspace:GetDescendants()) do
        if (part:IsA("Seat") or part:IsA("VehicleSeat")) and part.Occupant then
            local oc = part.Occupant.Parent
            if oc ~= char and Players:GetPlayerFromCharacter(oc) then return oc end
        end
    end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") or tool:IsA("Model") then
            for _, part in ipairs(tool:GetDescendants()) do
                if (part:IsA("Seat") or part:IsA("VehicleSeat")) and part.Occupant then
                    local oc = part.Occupant.Parent
                    if oc ~= char then return oc end
                end
            end
        end
    end
    return nil
end
local function wLite_resetAll()
    local char = LocalPlayer.Character
    if char then wLite_fire(char, wLite_NORMAL) end
    if wLite_lastPax then wLite_fire(wLite_lastPax, wLite_NORMAL) end
    wLite_removeForce()
    wLite_lastSit   = false
    wLite_lastPax   = nil
    wLite_cachedPax = nil
end

RunService.Heartbeat:Connect(function()
    if not wLite_modeA and not wLite_modeB then return end
    local char = LocalPlayer.Character
    if not char then return end
    local sitting = wLite_isSitting()
    local now = tick()
    if now - wLite_lastScan >= wLite_SCAN_GAP then
        wLite_cachedPax = wLite_scanPax()
        wLite_lastScan  = now
    end
    local passenger = wLite_cachedPax
    if wLite_modeA then
        if sitting then
            if not wLite_lastSit then
                wLite_fire(char, wLite_HEAVY)
                wLite_applyForce(char, -workspace.Gravity * 80)
            end
        else
            if wLite_lastSit then
                wLite_fire(char, wLite_NORMAL)
                wLite_removeForce()
            end
            if passenger ~= wLite_lastPax then
                if wLite_lastPax then wLite_fire(wLite_lastPax, wLite_NORMAL) end
                if passenger    then wLite_fire(passenger, wLite_LIGHT) end
            end
        end
    elseif wLite_modeB then
        if sitting then
            if not wLite_lastSit then
                wLite_fire(char, wLite_LIGHT)
                wLite_applyForce(char, workspace.Gravity * 80)
            end
        else
            if wLite_lastSit then
                wLite_fire(char, wLite_NORMAL)
                wLite_removeForce()
            end
            if passenger ~= wLite_lastPax then
                if wLite_lastPax then wLite_fire(wLite_lastPax, wLite_NORMAL) end
                if passenger    then wLite_fire(passenger, wLite_HEAVY) end
            end
        end
    end
    wLite_lastSit = sitting
    wLite_lastPax = passenger
end)

