local invisibleConn, invisiblePart, savedTransparency = nil, nil, {}
function DevTools.toggleInvisible(enable)
    DevTools.isInvisibleActive = (enable ~= nil) and enable or not DevTools.isInvisibleActive
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return false end

    if DevTools.isInvisibleActive then
        DevTools.invisibleSavedCF = root.CFrame
        for _, obj in ipairs(char:GetDescendants()) do
            if obj:IsA("BasePart") then savedTransparency[obj] = obj.Transparency; obj.Transparency = 1; obj.CanCollide = false
            elseif obj:IsA("Decal") or obj:IsA("Texture") then savedTransparency[obj] = obj.Transparency; obj.Transparency = 1 end
        end
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
        invisiblePart = Instance.new("Part"); invisiblePart.Name = "_FreecamDrone"; invisiblePart.Size = Vector3.new(1, 1, 1)
        invisiblePart.Transparency = 1; invisiblePart.CanCollide = false; invisiblePart.Anchored = true
        invisiblePart.CFrame = DevTools.invisibleSavedCF; invisiblePart.Parent = Workspace
        Camera.CameraSubject = invisiblePart
        invisibleConn = RunService.RenderStepped:Connect(function(dt)
            local speed = 60
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then speed = 20 end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then speed = 150 end
            local cf = Camera.CFrame; local dir = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cf.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cf.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cf.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cf.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.E) then dir = dir + Vector3.yAxis end
            if UserInputService:IsKeyDown(Enum.KeyCode.Q) then dir = dir - Vector3.yAxis end
            if dir.Magnitude > 0 then invisiblePart.CFrame = invisiblePart.CFrame + (dir.Unit * speed * dt) end
            root.Velocity = Vector3.zero; root.CFrame = invisiblePart.CFrame * CFrame.new(0, -30, 0)
        end)
    else
        if invisibleConn then invisibleConn:Disconnect(); invisibleConn = nil end
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
        hum:SetStateEnabled(Enum.HumanoidStateType.Physics, true)
        Camera.CameraSubject = hum
        if invisiblePart then root.CFrame = invisiblePart.CFrame; invisiblePart:Destroy(); invisiblePart = nil
        elseif DevTools.invisibleSavedCF then root.CFrame = DevTools.invisibleSavedCF end
        root.Velocity = Vector3.zero
        for obj, val in pairs(savedTransparency) do
            if obj and obj.Parent then if obj:IsA("BasePart") or obj:IsA("Decal") or obj:IsA("Texture") then obj.Transparency = val end end
        end
        table.clear(savedTransparency)
    end
    return DevTools.isInvisibleActive
end

