                        end
                    end
                end

                if activeBanana and bananaTarget and bananaTarget.Parent then
                    activeBanana.CanCollide = false
                    activeBanana.CFrame = bananaTarget.CFrame
                    activeBanana.Velocity = Vector3.new(0, 150, 0)
                elseif bananaTarget and not bananaTarget.Parent then
                    bananaTarget = nil
                end
            end)
        end
    else
        if bananaConn then bananaConn:Disconnect(); bananaConn = nil end
        if activeBanana then
            local bav = activeBanana:FindFirstChild("_BananaSpin")
            if bav then bav:Destroy() end
        end
        activeBanana = nil
        bananaTarget = nil
    end
    return DevTools.isBananaActive
end

