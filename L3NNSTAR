local function corner(p, r)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 12); c.Parent = p
end
local function stroke(p, t, col)
    local s = Instance.new("UIStroke"); s.Color = col or NB.Black; s.Thickness = t or 2.5
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Parent = p
end
local function shadow(p, ox, oy, r)
    local s = Instance.new("Frame"); s.Name = "_S"; s.Size = UDim2.new(1, 0, 1, 0)
    s.Position = UDim2.new(0, ox or 4, 0, oy or 4); s.BackgroundColor3 = NB.Black
    s.BorderSizePixel = 0; s.ZIndex = math.max(p.ZIndex - 1, 1); s.Parent = p
    if r then corner(s, r) end
end

