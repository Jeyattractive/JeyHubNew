-- Check profile dulu sebelum vote — untuk tau apakah CanRate
local function checkCanRate(userId)
    if not _reqProfile then return false end
    local ok, profile = pcall(function()
        return _reqProfile:InvokeServer(userId)
    end)
    if ok and profile then
        return profile.CanRate == true
    end
    return false
end

-- Fire vote: signature confirmed — InvokeServer(userId: number, voteType: string)
local function fireVote(userId)
    if not _submitVote then return false, "SubmitVote remote not found" end
    local ok, result = pcall(function()
        return _submitVote:InvokeServer(userId, "Like")
    end)
    if ok then
        -- result = {ok = bool, cost = number} or nil
        if result and result.ok then
            return true, result.cost or 250
        elseif result and result.ok == false then
            return false, "server rejected (not eligible)"
        else
            return true, 250  -- result nil = server processed tanpa return
        end
    else
        return false, tostring(result)
    end
end

