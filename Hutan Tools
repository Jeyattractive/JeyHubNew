local function getFishingRod()
    local c = lp.Character
    if c then
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") then return t end
        end
    end
    for _, t in ipairs(lp.Backpack:GetChildren()) do
        if t:IsA("Tool") then return t end
    end
    return nil
end
local function getFishList()
    local ok, result = pcall(function()
        local cfg = game:GetService("ReplicatedStorage")
            .Fishing_System.FishingSystem.Configuration.Fishes
        local list = {}
        for _, rarityFolder in ipairs(cfg:GetChildren()) do
            for _, fishObj in ipairs(rarityFolder:GetChildren()) do
                list[#list+1] = {
                    Fish_Name    = fishObj.Name,
                    FishImage    = fishObj:GetAttribute("FishImage") or "",
                    Sell_Price_KG = fishObj:GetAttribute("Sell_Price_Per_KG") or 100,
                    Weight       = math.random(
                        fishObj:GetAttribute("Weight") and fishObj:GetAttribute("Weight").Min or 1,
                        fishObj:GetAttribute("Weight") and fishObj:GetAttribute("Weight").Max or 10
                    ),
                }
            end
        end
        return list
    end)
    if ok and result and #result > 0 then return result end
    return FISH_FALLBACK
end
local function getBackpackFish()
    local fish = {}
    for _, tool in ipairs(lp.Backpack:GetChildren()) do
        if tool:IsA("Tool") and tool:GetAttribute("FishPrice") ~= nil then
            fish[#fish+1] = { Fish_Name = tool.Name, FishImage = "",
                Sell_Price_KG = tool:GetAttribute("FishPrice"), Weight = 1 }
        end
    end
    local c = lp.Character
    if c then
        for _, tool in ipairs(c:GetChildren()) do
            if tool:IsA("Tool") and tool:GetAttribute("FishPrice") ~= nil then
                fish[#fish+1] = { Fish_Name = tool.Name, FishImage = "",
                    Sell_Price_KG = tool:GetAttribute("FishPrice"), Weight = 1 }
            end
        end
    end
    return fish
end
local function fireFinalTask(fishData, priceSell, weightVal)
    local rod = getFishingRod()
    if not rod then flash("Tidak ada rod di backpack!", PAL.fire); return false end
    local data = {
        Fish_Name    = fishData.Fish_Name,
        FishImage    = fishData.FishImage or "",
        Sell_Price_KG = priceSell or fishData.Sell_Price_KG,
        Weight       = weightVal or fishData.Weight,
    }
    local ok = pcall(function()
        game:GetService("ReplicatedStorage").Fishing_System.Remotes.FinalTask:FireServer(rod, data)
    end)
    return ok
end
