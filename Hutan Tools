local function makeToggleBtn(parent, labelOff, labelOn, sub, colName, order, h)
    local btn = makeBtn(parent, labelOff .. "  [OFF]", sub, colName, order, h)
    local state = false
    local function getMainLabel() return btn:FindFirstChildOfClass("TextLabel") end
    local toggle = function()
        state = not state
        local ml = getMainLabel()
        if ml then ml.Text = (state and labelOn or labelOff) .. "  [" .. (state and "ON" or "OFF") .. "]" end
        return state
    end
    return btn, toggle, function() return state end
end
