-- Main toggle button
local ratingActive  = false
local ratingStats   = { ok = 0, skip = 0, fail = 0, coins = 0 }

local btnRateAll = makeBtn(worldPage,
    "Rate All Suka  [OFF]",
    "SubmitVote(userId, 'Like') — 250 coin per player",
    "green", 43, 36)

btnRateAll.MouseButton1Click:Connect(function()
    if ratingActive then
        ratingActive = false
        local ml = btnRateAll:FindFirstChildOfClass("TextLabel")
        if ml then ml.Text = "Rate All Suka  [OFF]" end
        ratingSubLbl.Text = string.format(
            "Stopped. OK:%d  Skip:%d  Fail:%d  -%.0f coin",
            ratingStats.ok, ratingStats.skip, ratingStats.fail, ratingStats.coins)
        return
    end

    if not _submitVote then
        flash("ReputationRemotes tidak ditemukan!", PAL.fire)
        return
    end

    ratingActive = true
    ratingStats  = { ok = 0, skip = 0, fail = 0, coins = 0 }

    local ml = btnRateAll:FindFirstChildOfClass("TextLabel")
    if ml then ml.Text = "Rate All Suka  [ON — klik stop]" end

    local delay = math.max(0.5, math.min(tonumber(rateDelayBox.Text) or 0.6, 15))

    task.spawn(function()
        local targets = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= lp then targets[#targets+1] = p end
        end

        local total = #targets
        if total == 0 then
            ratingNumLbl.Text = "0 / 0 player"
            ratingSubLbl.Text = "Tidak ada player lain di server"
            flash("Server kosong", PAL.subtext)
            ratingActive = false
            if ml then ml.Text = "Rate All Suka  [OFF]" end
            return
        end

        flash(string.format("Rating %d player… 250 coin/player", total), PAL.green)

        for i, target in ipairs(targets) do
            if not ratingActive then break end

            ratingNumLbl.Text = string.format("%d / %d player", i, total)
            ratingSubLbl.Text = string.format("Checking: %s…", target.Name)

            local uid = target.UserId

            -- Cek CanRate dulu agar tidak buang coin kalau sudah pernah di-rate
            local canRate = checkCanRate(uid)
            if not canRate then
                ratingStats.skip += 1
                ratingSubLbl.Text = string.format("Skip %s (sudah di-rate / tidak eligible)", target.Name)
                task.wait(0.3)
            else
                ratingSubLbl.Text = string.format("Voting: %s…", target.Name)
                local ok, resultOrErr = fireVote(uid)
                if ok then
                    ratingStats.ok    += 1
                    ratingStats.coins += (type(resultOrErr) == "number" and resultOrErr or 250)
                    ratingSubLbl.Text = string.format("✓ %s (+%s coin habis)", target.Name, tostring(resultOrErr))
                else
                    ratingStats.fail += 1
                    ratingSubLbl.Text = string.format("✗ %s — %s", target.Name, tostring(resultOrErr):sub(1,40))
                end
                task.wait(delay)
            end
        end

        ratingActive = false
        if ml then ml.Text = "Rate All Suka  [OFF]" end
        ratingNumLbl.Text = string.format("%d/%d OK  skip:%d  fail:%d",
            ratingStats.ok, total, ratingStats.skip, ratingStats.fail)
        ratingSubLbl.Text = string.format("Total coin habis: -%d", ratingStats.coins)
        flash(string.format("Selesai — %d rated, -%d coin", ratingStats.ok, ratingStats.coins), PAL.green)
    end)
end)

